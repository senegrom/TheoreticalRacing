+	private int racecraftProjectedRankForLanding(final int x, final int y, final int vx,
+			final int vy, final int playerNum) {
+		final Player me = game.players[game.subgamestate];
+		final RaceGame.MoveResult move = game.evaluateMove(me.getLap(), me.getNextGate(),
+				me.getPosition()[0], me.getPosition()[1], x, y,
+				game.isCrashingPlayer(x, y, playerNum));
+		if (!move.legal())
+			return Integer.MAX_VALUE;
+		return racecraftProjectedRank(racecraftCostAfter(move, x, y, vx, vy), x, y, playerNum);
+	}
