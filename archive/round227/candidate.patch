+	/** How many live rivals are projected ahead after their best one-move reply.
+	 * Every rival is counted: a duel gain may never be bought by losing a place
+	 * to the third car. Ties fail closed in the rival's favour. */
+	private int racecraftProjectedRank(final long myCost, final int blockX, final int blockY,
+			final int playerNum) {
+		int rank = 1;
+		for (int i = 0; i < game.players.length; i++) {
+			final Player p = game.players[i];
+			if (p.getNumber() == playerNum || p.isFinished())
+				continue;
+			if (racecraftBestReply(i, blockX, blockY, playerNum) <= myCost)
+				rank++;
+		}
+		return rank;
+	}
