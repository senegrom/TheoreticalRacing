+			final int ox = x[mover], oy = y[mover], ovx = vx[mover], ovy = vy[mover];
+			final boolean oa = alive[mover];
+			int nahead = ahead, nbehind = behind;
+			int child;
+			if (move.finishes()) {
+				alive[mover] = false;
+				if (mover == me)
+					child = ahead + 1;
+				else {
+					nahead++;
+					final int next = racecraftNextAlive(alive, mover);
+					child = racecraftLiveRivals(alive, me) == 0 ? nahead + 1
+							: racecraftPlaceSearch(x, y, vx, vy, alive, next, me, depth - 1,
+									nahead, nbehind, rootLive);
+				}
+			} else {
+				x[mover] = nx; y[mover] = ny; vx[mover] = nvx; vy[mover] = nvy;
+				final int next = racecraftNextAlive(alive, mover);
+				child = racecraftPlaceSearch(x, y, vx, vy, alive, next, me, depth - 1,
+						nahead, nbehind, rootLive);
+			}
+			x[mover] = ox; y[mover] = oy; vx[mover] = ovx; vy[mover] = ovy; alive[mover] = oa;
+			if (mover == me) {
+				if (child < value) value = child;
+				if (value == 1) break;
+			} else {
+				if (child > value) value = child;
+				if (value > rootLive) break;
+			}
+		}
+		if (any)
+			return value;
+		// Forced crash: no legal move. Already-crashed rivals finish behind me;
+		// a crash by me gets the worst still-unclaimed relative place.
+		if (mover == me)
+			return rootLive - behind;
+		alive[mover] = false;
+		final int next = racecraftNextAlive(alive, mover);
+		final int result = racecraftLiveRivals(alive, me) == 0 ? ahead + 1
+				: racecraftPlaceSearch(x, y, vx, vy, alive, next, me, depth - 1,
+						ahead, behind + 1, rootLive);
+		alive[mover] = true;
+		return result;
+	}
