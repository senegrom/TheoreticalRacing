+	/** Dynamic lane tie-break: count next-turn cells that I and any live rival
+	 * can both reach. Fewer conflicts means the actually open side of the track,
+	 * rather than a fixed left/right convention. */
+	private int racecraftFutureConflicts(final int x, final int y, final int vx, final int vy,
+			final int playerNum) {
+		int conflicts = 0;
+		for (final Direction md : DIRECTIONS) {
+			final int mvx = vx + md.dx, mvy = vy + md.dy;
+			if (RaceGame.aiVelocityOutOfRange(mvx, mvy))
+				continue;
+			final int mx = x + mvx, my = y + mvy;
+			if (!game.isMoveLegalGeometryCached(x, y, mx, my))
+				continue;
+			for (final Player r : game.players) {
+				if (r.getNumber() == playerNum || r.isFinished())
+					continue;
+				final int[] rp = r.getPosition(), rv = r.getVelocity();
+				boolean shared = false;
+				for (final Direction rd : DIRECTIONS) {
+					final int rvx = rv[0] + rd.dx, rvy = rv[1] + rd.dy;
+					if (RaceGame.aiVelocityOutOfRange(rvx, rvy))
+						continue;
+					if (rp[0] + rvx == mx && rp[1] + rvy == my
+							&& game.isMoveLegalGeometryCached(rp[0], rp[1], mx, my)) {
+						shared = true;
+						break;
+					}
+				}
+				if (shared)
