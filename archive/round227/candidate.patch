+	private long racecraftCostAfter(final RaceGame.MoveResult move,
+			final int x, final int y, final int vx, final int vy) {
+		if (move.finishes())
+			return 0;
+		final int remaining = game.lapGates == null ? 0
+				: OptimalPotential.remainingEvents(move.gateAfter(), move.lapAfter(), game.totalLaps);
+		final boolean aware = game.lapGates != null
+				&& (move.lapAfter() + 1 < game.totalLaps || move.gateAfter() != 0);
+		return racecraftCost(remaining, game.lapGates == null ? 0 : move.gateAfter(), aware,
+				x, y, vx, vy);
+	}
