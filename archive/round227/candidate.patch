+	/** Best immediate race-progress reply available to a rival after I occupy
+	 * (blockX,blockY). A forced crash is +INF, hence safely behind in the rank. */
+	private long racecraftBestReply(final int ri, final int blockX, final int blockY,
+			final int playerNum) {
+		final Player rival = game.players[ri];
+		final int[] rp = rival.getPosition(), rv = rival.getVelocity();
+		long best = RACECRAFT_INF;
+		for (final Direction d : DIRECTIONS) {
+			final int nvx = rv[0] + d.dx, nvy = rv[1] + d.dy;
+			if (RaceGame.aiVelocityOutOfRange(nvx, nvy))
+				continue;
+			final int nx = rp[0] + nvx, ny = rp[1] + nvy;
+			boolean occupied = nx == blockX && ny == blockY;
+			if (!occupied)
+				for (final Player q : game.players) {
+					if (q.isFinished() || q.getNumber() == playerNum || q.getNumber() == rival.getNumber())
+						continue;
+					final int[] qp = q.getPosition();
+					if (qp[0] == nx && qp[1] == ny) {
+						occupied = true;
+						break;
+					}
+				}
+			final RaceGame.MoveResult move = game.evaluateMove(rival.getLap(), rival.getNextGate(),
+					rp[0], rp[1], nx, ny, occupied);
+			if (!move.legal())
+				continue;
+			final long cost = racecraftCostAfter(move, nx, ny, nvx, nvy);
+			if (cost < best)
+				best = cost;
+		}
+		return best;
+	}
