+	/** A stage-aware cost used only by the candidate race-position layer. With an
+	 * exact potential this is full-race moves remaining. Without one, remaining
+	 * gate events dominate the local turns-to-next-gate value. */
+	private long racecraftCost(final int remaining, final int gate, final boolean aware,
+			final int x, final int y, final int vx, final int vy) {
+		if (exactPot != null) {
+			final int t = exactPot.movesToFinish(remaining, x, y, vx, vy);
+			return t == Integer.MAX_VALUE ? RACECRAFT_INF : t;
+		}
+		final int t = aware ? reach.turnsToGate(gate, x, y, vx, vy)
+				: reach.turnsToFinish(x, y, vx, vy);
+		if (t == Integer.MAX_VALUE)
+			return RACECRAFT_INF;
+		return ((long) remaining << 32) | t & 0xffffffffL;
+	}
