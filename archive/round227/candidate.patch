+	private int racecraftPlaceSearch(final int[] x, final int[] y, final int[] vx, final int[] vy,
+			final boolean[] alive, final int mover, final int me, final int depth,
+			final int ahead, final int behind, final int rootLive) {
+		if (++racecraftPlaceNodes > RACECRAFT_PLACE3_NODES || depth <= 0)
+			return rootLive + 1;
+		if (!alive[me])
+			return rootLive - behind;
+		if (racecraftLiveRivals(alive, me) == 0)
+			return ahead + 1;
+		boolean any = false;
+		int value = mover == me ? rootLive + 1 : 0;
+		for (final Direction d : DIRECTIONS) {
+			final int nvx = vx[mover] + d.dx, nvy = vy[mover] + d.dy;
+			if (RaceGame.aiVelocityOutOfRange(nvx, nvy))
+				continue;
+			final int nx = x[mover] + nvx, ny = y[mover] + nvy;
+			final RaceGame.MoveResult move = game.evaluateMove(game.totalLaps - 1, 0,
+					x[mover], y[mover], nx, ny, racecraftOccupied(alive, x, y, mover, nx, ny));
+			if (!move.legal())
