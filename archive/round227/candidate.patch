+	private int racecraftPlaceGuarantee(final int[] pos, final int[] vel, final int playerNum,
+			final Direction root, final int rootLive) {
+		final int me = game.subgamestate;
+		final int[] x = new int[game.players.length], y = new int[game.players.length];
+		final int[] vx = new int[game.players.length], vy = new int[game.players.length];
+		final boolean[] alive = new boolean[game.players.length];
+		for (int i = 0; i < game.players.length; i++) {
+			final Player p = game.players[i];
+			final int[] q = p.getPosition(), v = p.getVelocity();
+			x[i] = q[0]; y[i] = q[1]; vx[i] = v[0]; vy[i] = v[1]; alive[i] = !p.isFinished();
+		}
+		final int nvx = vel[0] + root.dx, nvy = vel[1] + root.dy;
+		if (RaceGame.aiVelocityOutOfRange(nvx, nvy))
+			return rootLive + 1;
+		final int nx = pos[0] + nvx, ny = pos[1] + nvy;
+		final RaceGame.MoveResult move = game.evaluateMove(game.totalLaps - 1, 0, pos[0], pos[1],
