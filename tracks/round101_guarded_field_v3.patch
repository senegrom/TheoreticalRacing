+					+ " -> " + turnsByDir[best.ordinal()] + " ahead=" + rivalsAhead
+					+ " progress=" + aheadProgress + " self " + chosenFinal + " -> "
+					+ bestFinal + " field " + chosenField + " -> " + bestField);
+		return best != null ? best : chosen;
+	}
