+		if (chosenIndex < 0 || finishRound[chosenIndex] >= 0)
+			return chosen;
+
+		Direction best = null;
+		int bestRound = Integer.MAX_VALUE;
+		int bestTier = Integer.MIN_VALUE;
+		int bestT = Integer.MAX_VALUE;
+		double bestTrap = Double.MAX_VALUE;
+		for (int i = 0; i < candidateCount; i++) {
+			if (finishRound[i] < 0)
