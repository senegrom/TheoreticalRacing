+			final int normalizedRound = finishRound[i] == 0
+					? AI1_FINISH_DENIAL_TTF + 1 : finishRound[i];
+			if (best == null || normalizedRound < bestRound
+					|| normalizedRound == bestRound && finalTier[i] > bestTier
+					|| normalizedRound == bestRound && finalTier[i] == bestTier
+							&& candidateT[i] < bestT
+					|| normalizedRound == bestRound && finalTier[i] == bestTier
+							&& candidateT[i] == bestT && candidateTrap[i] < bestTrap) {
+				best = candidates[i];
+				bestRound = normalizedRound;
+				bestTier = finalTier[i];
+				bestT = candidateT[i];
+				bestTrap = candidateTrap[i];
+			}
+		}
+		if (best != null && AI_DEBUG_FINISH_DENIAL) {
+			System.err.println("AIDBG FINISH-DENIAL p=" + playerNum + " pos=(" + pos[0]
+					+ "," + pos[1] + ") chosen=" + chosen + " t=" + chosenT
+					+ " dead; brake=" + best + " t=" + bestT + " round=" + bestRound
+					+ " tier=" + bestTier + " finishRivals=" + finishRivals);
+			for (int i = 0; i < candidateCount; i++)
+				System.err.println("AIDBG FINISH-DENIAL   " + candidates[i] + " t="
+						+ candidateT[i] + " out=" + finishRound[i] + " tier="
+						+ finalTier[i] + " thread=" + threadRound[i]);
+		}
+		return best != null ? best : chosen;
+	}
