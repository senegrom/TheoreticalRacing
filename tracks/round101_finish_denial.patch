+			return chosen;
+		final int chosenT = turnsByDir[chosen.ordinal()];
+		if (chosenT == Integer.MAX_VALUE || chosenT > AI1_FINISH_DENIAL_TTF)
+			return chosen;
+
+		int finishRivals = 0;
+		for (final Player rival : game.players) {
+			if (rival.getNumber() == playerNum || rival.isFinished())
+				continue;
+			final int[] rivalPos = rival.getPosition();
+			final int[] rivalVel = rival.getVelocity();
+			final int rivalT = reach.turnsToFinish(rivalPos[0], rivalPos[1], rivalVel[0], rivalVel[1]);
+			if (rivalT != Integer.MAX_VALUE && rivalT <= AI1_FINISH_DENIAL_TTF)
+				finishRivals++;
+		}
+		if (finishRivals < 3)
+			return chosen;
+
+		final Direction[] candidates = new Direction[DIRECTIONS.length];
+		final int[] candidateT = new int[DIRECTIONS.length];
+		final double[] candidateTrap = new double[DIRECTIONS.length];
+		int candidateCount = 0;
+		for (final Direction d : DIRECTIONS) {
+			final int turns = turnsByDir[d.ordinal()];
+			if (turns == Integer.MAX_VALUE || turns > AI1_FINISH_DENIAL_TTF
+					|| trapByDir[d.ordinal()] == Double.MAX_VALUE)
+				continue;
+			final int nvx = vel[0] + d.dx, nvy = vel[1] + d.dy;
+			if (RaceGame.aiVelocityOutOfRange(nvx, nvy))
+				continue;
+			final int nx = pos[0] + nvx, ny = pos[1] + nvy;
+			if (!game.isMoveLegalGeometryCached(pos[0], pos[1], nx, ny)
+					|| collision(new int[] {nx, ny}, playerNum)
+					|| sealable(nx, ny, nvx, nvy, playerNum))
+				continue;
+			candidates[candidateCount] = d;
+			candidateT[candidateCount] = turns;
+			candidateTrap[candidateCount] = trapByDir[d.ordinal()];
+			candidateCount++;
+		}
+		if (candidateCount < 2)
+			return chosen;
+
+		final int[] finishRound = new int[candidateCount];
+		final int[] finalTier = new int[candidateCount];
+		final int[] threadRound = new int[candidateCount];
+		inTrueRivalConfirm = true;
+		try {
+			for (int i = 0; i < candidateCount; i++) {
+				final Direction d = candidates[i];
+				final int nvx = vel[0] + d.dx, nvy = vel[1] + d.dy;
+				finishRound[i] = simOutcome(pos[0] + nvx, pos[1] + nvy, nvx, nvy,
+						playerNum, AI1_FINISH_DENIAL_TTF, true, true, true, true, true,
+						AI1_DEEP_CERT_RIVALS, new int[] {0}, null, new int[] {-1});
+				// Re-run only for audit outputs when the candidate survived. Keeping
+				// the production verdict and audit extraction separate prevents a
+				// shared scratch array from leaking one candidate's flags into another.
+				if (finishRound[i] >= 0) {
+					final int[] tierOut = new int[1];
+					final int[] threadOut = new int[] {-1};
+					finishRound[i] = simOutcome(pos[0] + nvx, pos[1] + nvy, nvx, nvy,
+							playerNum, AI1_FINISH_DENIAL_TTF, true, true, true, true, true,
+							AI1_DEEP_CERT_RIVALS, tierOut, null, threadOut);
+					finalTier[i] = tierOut[0];
+					threadRound[i] = threadOut[0];
+				}
+			}
+		} finally {
+			inTrueRivalConfirm = false;
+		}
